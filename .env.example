APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# CPU-work safety bound (max iterations for dummy workload)
MAX_CPU_ITERATIONS=500000

# artificial-delay safety bound (max ms for dummy workload)
MAX_DELAY_MS=2000

# target Deployment namespace
TARGET_NAMESPACE=apa-system

# target Deployment name
TARGET_DEPLOYMENT=workload-api

MIN_REPLICAS=1
MAX_REPLICAS=10
MAX_SCALE_UP_STEP=3
MAX_SCALE_DOWN_STEP=1
COOLDOWN_SECONDS=60

# live-scaling safety switch (must be true and mode must be live to scale)
ENABLE_LIVE_SCALING=false
CONTROLLER_MODE=observe

# Prometheus address
PROMETHEUS_URL=http://prometheus-operated.monitoring.svc:9090
TELEMETRY_STALE_AFTER_SECONDS=30

SLO_LATENCY_MS=500.0
RANDOM_SEED=42
